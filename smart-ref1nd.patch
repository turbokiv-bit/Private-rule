+	sort.SliceStable(candidates, func(i, j int) bool {
+		return result[candidates[i].Tag()] < result[candidates[j].Tag()]
+	})
+	if len(candidates) > urlTestPrecisionCandidates {
+		candidates = candidates[:urlTestPrecisionCandidates]
+	}

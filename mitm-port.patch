+	switch o.Source {
+	case C.ScriptSourceTypeLocal:
+		source = &o.LocalOptions
+	case C.ScriptSourceTypeRemote:
+		source = &o.RemoteOptions
+	default:
+		return E.New("unknown script source: ", o.Source)
+	}
+	return json.Unmarshal(bytes, source)
+}

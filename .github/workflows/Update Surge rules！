on:
  schedule:
    # Upstream currently updates around 03:00 UTC; run daily at 04:15 UTC.
    - cron: "15 4 * * *"
  workflow_dispatch:

permissions:
  contents: write

concurrency:
  group: update-surge-rules
  cancel-in-progress: true

jobs:
  update:
    runs-on: ubuntu-latest
    timeout-minutes: 10

    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: "3.12"

      - name: Download and convert rules
        run: |
          python scripts/convert.py \
            --source "https://static-file-global.353355.xyz/rules/cn-additional-list.txt" \
            --output "rules/cn-additional-list.list"

      - name: Commit updated rules
        run: |
          if git diff --quiet -- rules/cn-additional-list.list; then
            echo "No rule changes."
            exit 0
          fi

          git config user.name "github-actions[bot]"
          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
          git add rules/cn-additional-list.list
          git commit -m "chore: update Surge rules"
          git push

+}
+
+// GoroutineDump returns a stack dump of all Goroutines. It is exported to the
+// front-end as LibboxGoroutineDump (SFI's debug view). Added to reF1nd-testing
+// to satisfy the front-end (latest sing-box-for-apple) interface.
+func GoroutineDump() string {
+	buffer := make([]byte, 64*1024)
+	for {
+		n := runtime.Stack(buffer, true)
+		if n < len(buffer) {
+			return string(buffer[:n])
+		}
+		buffer = make([]byte, 2*len(buffer))
+	}
+}

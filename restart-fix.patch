+// boxRestarter adapts CommandServer to adapter.BoxRestartFunc.
+type boxRestarter CommandServer
+
+func (b *boxRestarter) Restart() error {
+	log.StdLogger().Warn("box-restart requested (bridge session stale), reloading service")
+	return (*CommandServer)(b).handler.ServiceReload()
+}

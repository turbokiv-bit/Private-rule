index 00000000..c0a7e637
--- /dev/null
+++ b/adapter/box_restart.go
@@ -0,0 +1,11 @@
+package adapter
+
+// BoxRestartFunc is injected by the iOS/libbox layer into the service
+// registry so a bridge outbound can request a full configuration reload
+// (which rebuilds every outbound, including the stale bridge session) when
+// the platform bridge session can no longer be re-applied after a network
+// change. Calling it tears down and recreates the entire box service, so it
+// must be invoked asynchronously and is expected to be idempotent-safe.
+type BoxRestartFunc interface {
+	Restart() error
+}

+// restart recreates the platform bridge session after a network change left
+// the old egress unusable ("bridge session not found"). It is invoked through
+// backendBase.rebuild (owned by the Outbound) under lifecycleMu, never from
+// inside a network-monitor callback. It tears down the stale session / tun /
+// PF anchor / read loop and re-runs startPlatform so a fresh BridgeSession is
+// created on the current default interface, then re-syncs egress.
+func (b *backendDarwin) restart() {
+	b.egressAccess.Lock()
+	defer b.egressAccess.Unlock()
+
+	if b.closed != nil {
+		select {
+		case <-b.closed:
+			return // already fully closed
+		default:
+		}
+	}
+
+	b.logger.Warn("bridge: recreating platform bridge session")
+	if b.unregister != nil {
+		b.unregister()
+		b.unregister = nil
+	}
+	// Ask the current read loop to stop before we tear down the tun FD.
+	// Closing the stopReload channel (not b.closed, which is the final
+	// Close() signal and must not be double-closed) lets batchReadLoop
+	// exit deterministically once BatchRead returns.
+	if b.stopReload != nil {
+		close(b.stopReload)
+		b.stopReload = nil
+	}
+	if b.pfDevice != nil && b.anchorName != "" {
+		_ = b.pfDevice.LoadAnchor(b.anchorName, nil)
+	}
+	if b.tunInterface != nil {
+		_ = b.tunInterface.Close()
+		b.tunInterface = nil
+	}
+	if b.readDone != nil {
+		<-b.readDone
+	}
+	if b.session != nil {
+		_ = b.session.Close()
+		b.session = nil
+	}
+	b.batchTUN = nil
+	b.currentRules = nil
+	b.currentEgress = ""
+	// closed/readDone channels get re-created inside startPlatform.
+
+	if err := b.startPlatform(); err != nil {
+		b.logger.Error(E.Cause(err, "bridge: failed to recreate session"))
+		return
+	}
+}
